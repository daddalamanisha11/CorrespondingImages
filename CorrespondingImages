  DateTime? _getAppointmentDateTime(
    Map<String, String> appointment,
  ) {
    try {
      final dateParts = appointment["date"]!.split('/');
      final timeParts = appointment["time"]!.split(' ');
      final clock = timeParts[0].split(':');

      int hour = int.parse(clock[0]);
      final minute = int.parse(clock[1]);

      final period =
          timeParts.length > 1
              ? timeParts[1].toUpperCase()
              : '';

      if (period == 'PM' && hour != 12) {
        hour += 12;
      }

      if (period == 'AM' && hour == 12) {
        hour = 0;
      }

      return DateTime(
        int.parse(dateParts[2]),
        int.parse(dateParts[1]),
        int.parse(dateParts[0]),
        hour,
        minute,
      );
    } catch (_) {
      return null;
    }
  }

  Map<String, String>? _nextAppointment() {
    final now = DateTime.now();

    Map<String, String>? next;
    DateTime? nextTime;

    for (final appointment in bookedAppointments) {
      final appointmentTime =
          _getAppointmentDateTime(appointment);

      if (appointmentTime != null &&
          appointmentTime.isAfter(now)) {
        if (nextTime == null ||
            appointmentTime.isBefore(nextTime)) {
          next = appointment;
          nextTime = appointmentTime;
        }
      }
    }

    return next;
  }

  String _timeLeft(DateTime appointmentTime) {
    final difference =
        appointmentTime.difference(DateTime.now());

    if (difference.isNegative) {
      return "Appointment time reached";
    }

    final days = difference.inDays;
    final hours =
        difference.inHours.remainder(24);
    final minutes =
        difference.inMinutes.remainder(60);
    final seconds =
        difference.inSeconds.remainder(60);

    if (days > 0) {
      return "${days}d ${hours}h ${minutes}m ${seconds}s";
    }

    if (hours > 0) {
      return "${hours}h ${minutes}m ${seconds}s";
    }

    return "${minutes}m ${seconds}s";
  }

