    showDialog(
      context: context,
      builder: (dialogContext) {
        return AlertDialog(
          title: const Text(
            "Cancel Appointment?",
          ),
          content: Text(
            "Are you sure you want to cancel the appointment for $patientName?",
          ),
          actions: [
            TextButton(
              onPressed: () =>
                  Navigator.pop(
                dialogContext,
              ),
              child:
                  const Text("No"),
            ),
            ElevatedButton(
              onPressed: () {
                setState(() {
                  bookedAppointments
                      .removeAt(index);
                });

                Navigator.pop(
                  dialogContext,
                );

                ScaffoldMessenger.of(
                        context)
                    .showSnackBar(
                  const SnackBar(
                    content: Text(
                      "Appointment cancelled successfully.",
                    ),
                  ),
                );
              },
              style:
                  ElevatedButton.styleFrom(
                backgroundColor:
                    Colors.red,
                foregroundColor:
                    Colors.white,
              ),
              child: const Text(
                "Yes, Cancel",
              ),
            ),
          ],
        );
      },
    );
